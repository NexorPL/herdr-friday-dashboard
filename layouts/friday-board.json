{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "work-body",
          "type": "column",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "friday-board",
              "type": "block",
              "background": "background",
              "radius": 10,
              "border": {
                "width": 1,
                "color": "border"
              },
              "min": 140,
              "size": {
                "weight": 2
              },
              "content": {
                "mod": "friday",
                "props": {
                  "widget": "board",
                  "block": true
                }
              }
            },
            {
              "id": "lower",
              "type": "row",
              "gap": 8,
              "size": {
                "weight": 3
              },
              "children": [
                {
                  "id": "friday-grid",
                  "type": "row",
                  "gap": 8,
                  "size": {
                    "weight": 3
                  },
                  "children": [
                    {
                      "id": "friday-col-1",
                      "type": "column",
                      "gap": 8,
                      "min": 60,
                      "size": {
                        "weight": 1
                      },
                      "children": [
                        {
                          "id": "friday-summary",
                          "type": "block",
                          "background": "background",
                          "radius": 10,
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "min": 90,
                          "size": {
                            "weight": 1
                          },
                          "content": {
                            "mod": "friday",
                            "props": {
                              "widget": "summary",
                              "block": true
                            }
                          }
                        },
                        {
                          "id": "friday-meetings",
                          "type": "block",
                          "background": "background",
                          "radius": 10,
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "min": 90,
                          "size": {
                            "weight": 1
                          },
                          "content": {
                            "mod": "friday",
                            "props": {
                              "widget": "meetings",
                              "block": true
                            }
                          }
                        }
                      ]
                    },
                    {
                      "id": "friday-col-2",
                      "type": "column",
                      "gap": 8,
                      "min": 60,
                      "size": {
                        "weight": 1
                      },
                      "children": [
                        {
                          "id": "friday-prs",
                          "type": "block",
                          "background": "background",
                          "radius": 10,
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "min": 90,
                          "size": {
                            "weight": 1
                          },
                          "content": {
                            "mod": "friday",
                            "props": {
                              "widget": "prs",
                              "block": true
                            }
                          }
                        },
                        {
                          "id": "friday-ledger",
                          "type": "block",
                          "background": "background",
                          "radius": 10,
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "min": 90,
                          "size": {
                            "weight": 1
                          },
                          "content": {
                            "mod": "friday",
                            "props": {
                              "widget": "ledger",
                              "block": true
                            }
                          }
                        }
                      ]
                    },
                    {
                      "id": "friday-col-3",
                      "type": "column",
                      "gap": 8,
                      "min": 60,
                      "size": {
                        "weight": 1
                      },
                      "children": [
                        {
                          "id": "friday-favorites",
                          "type": "block",
                          "background": "background",
                          "radius": 10,
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "min": 90,
                          "size": {
                            "weight": 1
                          },
                          "content": {
                            "mod": "friday",
                            "props": {
                              "widget": "favorites",
                              "block": true
                            }
                          }
                        }
                      ]
                    },
                    {
                      "id": "friday-notes",
                      "type": "block",
                      "background": "background",
                      "radius": 10,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "min": 60,
                      "size": {
                        "weight": 1
                      },
                      "content": {
                        "mod": "friday",
                        "props": {
                          "widget": "notes",
                          "block": true
                        }
                      }
                    }
                  ]
                },
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 8,
                      "radius": 10,
                      "background": "background",
                      "lone": true,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "header": {
                        "content": {
                          "mod": "friday",
                          "props": {
                            "paneHead": true
                          }
                        },
                        "height": 30,
                        "position": "top",
                        "reveal": "always"
                      }
                    }
                  },
                  "size": {
                    "weight": 2
                  },
                  "min": 240
                },
                {
                  "id": "panel",
                  "type": "column",
                  "hidden": true,
                  "size": {
                    "px": 368
                  },
                  "min": 280,
                  "max": 900,
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "active": "files",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ]
}
